[Unit]
Description=Tond Server
Documentation=https://tond.io/docs
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tond
ExecStart=/opt/tond/bin/tond-server
Restart=on-failure
RestartSec=5

# Environment Configuration
# These can be overridden with: systemctl edit tond-server

# Bind address (default: 127.0.0.1 - localhost only)
# Change to 0.0.0.0 only if you have a reverse proxy in front
Environment=TOND_BIND=127.0.0.1

# API server port (default: 3001)
Environment=TOND_PORT=3001

# Database file path
Environment=TOND_DB_PATH=/opt/tond/data/tond.db

# Dashboard static files directory
Environment=TOND_DASHBOARD_DIR=/opt/tond/dashboard

# Logging level: trace, debug, info, warn, error
Environment=RUST_LOG=info

# Non-root shell user used by the dashboard terminal pane
Environment=TOND_TERMINAL_USER=tond

# Docker config dir — must be writable; keeps docker CLI config off /root
# which is read-only under ProtectHome=true
Environment=DOCKER_CONFIG=/opt/tond/data/docker-config

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tond/data /tmp

[Install]
WantedBy=multi-user.target
