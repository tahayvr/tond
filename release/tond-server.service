[Unit]
Description=Tond Server
Documentation=https://docs.tond.io
After=network.target docker.service tondbuild.slice
Requires=docker.service
# The build slice must be active (its cgroup created with the memory cap)
# before any build lands in it; see tondbuild.slice.
Wants=tondbuild.slice

[Service]
Type=simple
# tond-server stays root: it drives Docker (root-equivalent anyway), owns the
# root-only CLI socket (tond.sock, 0600) and switches to TOND_TERMINAL_USER for
# the dashboard terminal. tond-proxy runs unprivileged (see tond-proxy.service).
User=root
WorkingDirectory=/opt/tond
ExecStart=/opt/tond/bin/tond-server
Restart=on-failure
RestartSec=5

# ── Graceful shutdown ──
# SIGTERM goes to tond-server only (not to a running `git clone` or build
# client): it stops accepting work, lets in-flight deploys, cron runs and
# backups finish for TOND_SHUTDOWN_GRACE_SECS (default 45 s), marks the rest
# interrupted and exits. systemd kills whatever is left after TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=90

# ── Resource guard rails ──
# Idle tond-server uses ~15 MB. Image builds run in tondbuild.slice (the
# Docker daemon's cgroup), not here; git clones, compose/docker CLI calls and
# the dashboard's host-terminal shells do run in this cgroup.
MemoryHigh=512M
MemoryMax=1G
TasksMax=512
# Tond is never the OOM victim: under memory pressure the kernel kills app
# containers first.
OOMScoreAdjust=-900
# glibc creates up to 8 malloc arenas per core; two keep RSS flat.
Environment=MALLOC_ARENA_MAX=2

# At-rest encryption key for stored secrets (TOND_SECRET_KEY). Generated by
# install.sh / update.sh; root-only (0600). Back it up — losing it makes stored
# registry passwords, Git tokens, storage keys and 2FA secrets unrecoverable.
# To rotate: move the old value to TOND_PREVIOUS_SECRET_KEY in the same file,
# set a new TOND_SECRET_KEY, restart, then remove TOND_PREVIOUS_SECRET_KEY.
# The leading '-' lets systemd start without the file; tond-server itself then
# refuses to run (release builds) and explains how to create the key.
EnvironmentFile=-/opt/tond/data/tond.env

# Environment Configuration
# These can be overridden with: systemctl edit tond-server

# Bind address (default: 127.0.0.1 - localhost only)
# Change to 0.0.0.0 only if you have a reverse proxy in front
Environment=TOND_BIND=127.0.0.1

# API server port (default: 3001)
Environment=TOND_PORT=3001

# Database file path
Environment=TOND_DB_PATH=/opt/tond/data/tond.db

# Dashboard static files directory
Environment=TOND_DASHBOARD_DIR=/opt/tond/dashboard

# Logging level: trace, debug, info, warn, error
Environment=RUST_LOG=info

# Log format: text (default, readable in journalctl) or json (one JSON object
# per line with level, target, message and span fields, for log shippers).
# Set it with: systemctl edit tond-server
# Environment=TOND_LOG_FORMAT=json

# Non-root shell user used by the dashboard terminal pane
Environment=TOND_TERMINAL_USER=tond

# Docker config dir — must be writable; keeps docker CLI config off /root
# which is read-only under ProtectHome=true
Environment=DOCKER_CONFIG=/opt/tond/data/docker-config

# ── Privileges ──
NoNewPrivileges=true
# Deliberately 0022, not 0077: git checkouts and extracted uploads become the
# `docker build` context, whose file modes end up in the image — owner-only
# files would be unreadable to images that run as a non-root USER. The data
# directory itself is what keeps tond.db, keys and backups private (root-only
# subdirectories under a root:tond-proxy 3770 /opt/tond/data, see install.sh).
UMask=0022

# ── Sandboxing ──
ProtectSystem=strict
ReadWritePaths=/opt/tond/data
ProtectHome=true
# Private /tmp: uploads (/tmp/tond-uploads) and snapshot staging are not
# visible to other services or users.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
