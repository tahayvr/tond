[Unit]
Description=Tond Reverse Proxy
Documentation=https://docs.tond.io
After=network.target tond-server.service
Wants=tond-server.service

[Service]
Type=simple
# The proxy parses untrusted TLS and HTTP from the internet, so it runs as a
# dedicated unprivileged user whose only capability is binding ports 80/443.
# File access (see install.sh secure_data_dir):
#   /opt/tond/data                  root:tond-proxy 3770 (setgid + sticky: it can
#                                   create files, e.g. SQLite's -wal/-shm, but not
#                                   remove or replace root's files)
#   tond.db, tond.db-wal, -shm      root:tond-proxy 0660 (shared with tond-server)
#   certs/, acme_account.json       tond-proxy only (0700 / 0600)
#   tond.env, root-api-key, setup-token, tond.sock, keys/, backups/, ...  root only
User=tond-proxy
Group=tond-proxy
WorkingDirectory=/opt/tond
ExecStart=/opt/tond/bin/tond-proxy
Restart=on-failure
RestartSec=5

# Environment Configuration
# These can be overridden with: systemctl edit tond-proxy

# Database file path (shared with tond-server)
Environment=TOND_DB_PATH=/opt/tond/data/tond.db

# Data directory for certificates and ACME credentials
Environment=TOND_DATA_DIR=/opt/tond/data

# Upstream server address (tond-server)
Environment=TOND_SERVER_ADDR=127.0.0.1:3001

# Dashboard domain (optional)
# Set this to serve the dashboard on a subdomain via HTTPS
# Example: dash.yourdomain.com
# Environment=TOND_DASHBOARD_DOMAIN=

# ACME/Let's Encrypt configuration
# Use staging for testing to avoid rate limits
# Environment=TOND_ACME_STAGING=false
# Custom ACME directory URL (overrides TOND_ACME_STAGING; used by the e2e tests)
# Environment=TOND_ACME_DIRECTORY=

# Logging level: trace, debug, info, warn, error
Environment=RUST_LOG=info

# ── Privileges ──
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Keys, certificates and the ACME account are written owner-only. SQLite gives
# -wal/-shm the mode of tond.db itself (0660), independent of the umask.
UMask=0077

# ── Sandboxing ──
ProtectSystem=strict
ReadWritePaths=/opt/tond/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
