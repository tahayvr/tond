[Unit]
Description=Tond Reverse Proxy
Documentation=https://tond.io/docs
After=network.target tond-server.service
Wants=tond-server.service

[Service]
Type=simple
# The proxy parses untrusted TLS and HTTP from the internet, so it runs as a
# dedicated unprivileged user whose only capability is binding ports 80/443.
# File access (see install.sh secure_data_dir):
#   /opt/tond/data                  root:tond-proxy 3770 (setgid + sticky: it can
#                                   create its own files, but not remove or
#                                   replace root's files)
#   tond.db, tond.db-wal, -shm      root:tond-proxy 0640: read-only for the proxy,
#                                   which also opens the database with mode=ro
#   proxy.sock                      tond-proxy 0600: control socket; only root
#                                   (tond-server) and tond-proxy may connect
#   certs/, acme_account.json       tond-proxy only (0700 / 0600)
#   access/                         tond-proxy only (0700; files 0600): opt-in
#                                   per-app access logs, 60 MB per app at most
#   tond.env, setup-token, tond.sock, keys/, backups/, ...  root only
User=tond-proxy
Group=tond-proxy
WorkingDirectory=/opt/tond
ExecStart=/opt/tond/bin/tond-proxy
Restart=on-failure
RestartSec=5

# ── Resource guard rails ──
# Idle tond-proxy uses ~10 MB; buffers grow with concurrent connections.
MemoryHigh=192M
MemoryMax=384M
TasksMax=128
# Never the OOM victim: without the proxy no app is reachable.
OOMScoreAdjust=-900
Environment=MALLOC_ARENA_MAX=2

# Environment Configuration
# These can be overridden with: systemctl edit tond-proxy

# Database file path (shared with tond-server)
Environment=TOND_DB_PATH=/opt/tond/data/tond.db

# Data directory for certificates and ACME credentials
Environment=TOND_DATA_DIR=/opt/tond/data

# Upstream server address (tond-server)
Environment=TOND_SERVER_ADDR=127.0.0.1:3001

# The dashboard domain is a setting (tond-server seeds it from its own
# TOND_DASHBOARD_DOMAIN, see install.sh); the proxy reads it from tond.db.

# Control socket shared with tond-server (default: $TOND_DATA_DIR/proxy.sock)
# Environment=TOND_PROXY_SOCKET=

# ACME/Let's Encrypt configuration
# Use staging for testing to avoid rate limits
# Environment=TOND_ACME_STAGING=false
# Custom ACME directory URL (overrides TOND_ACME_STAGING; used by the e2e tests)
# Environment=TOND_ACME_DIRECTORY=

# Logging level: trace, debug, info, warn, error
Environment=RUST_LOG=info

# Log format: text (default, readable in journalctl) or json (one JSON object
# per line with level, target, message and span fields, for log shippers).
# Set it with: systemctl edit tond-proxy
# Environment=TOND_LOG_FORMAT=json

# ── Privileges ──
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Keys, certificates and the ACME account are written owner-only. SQLite gives
# -wal/-shm the mode of tond.db itself (0660), independent of the umask.
UMask=0077

# ── Sandboxing ──
ProtectSystem=strict
ReadWritePaths=/opt/tond/data
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
