# Stage 1: Build
FROM rust:1.94.1-slim-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
RUN cargo build --release

# Stage 2: Production
FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/target/release/rust-axum ./rust-axum
EXPOSE 8080
CMD ["./rust-axum"]
